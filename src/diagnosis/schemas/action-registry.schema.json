{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory-diagnosis/action-registry/1.0",
  "title": "Inventory diagnosis action registry",
  "type": "object",
  "required": ["schema_version", "registry_version", "actions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_version": { "type": "string", "minLength": 1 },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_id", "label", "mode", "requires_confirmation"],
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["link", "draft", "manual", "unavailable"] },
          "requires_confirmation": { "type": "boolean" }
        }
      }
    }
  }
}
