{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory-diagnosis/decision-tree/1.0",
  "title": "Inventory diagnosis decision tree",
  "type": "object",
  "required": ["schema_version", "ruleset_id", "rule_code", "rule_version", "status", "nodes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "ruleset_id": { "type": "string", "minLength": 1 },
    "rule_code": { "enum": ["D2_NEGATIVE_STOCK", "D1_STOCK_VARIANCE", "S1_REPLENISHMENT_RISK", "T2_SUPPLY_CONSUMPTION_IMBALANCE"] },
    "rule_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "shadow", "active", "retired"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "type"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["condition", "calculate", "rank", "require_evidence", "exclude", "suggest_action", "set_status", "stop"] }
        }
      }
    }
  }
}
