{
  "schema_version": "1.0",
  "schema_name": "metric_dictionary",
  "schema_description": "加盟商运营诊断指标字典 — Codex 实现 RAG / Skill / Dashboard 时以此为字段映射基线",
  "schema_fields": [
    {"name": "metric_id", "type": "string", "required": true, "format": "M-{NNN}", "description": "指标唯一 ID，3 位零填充"},
    {"name": "name_zh", "type": "string", "required": true, "description": "中文名（用户可见）"},
    {"name": "name_en", "type": "string", "required": true, "description": "英文名（用于 RAG chunk 检索）"},
    {"name": "category", "type": "string", "required": true, "enum": ["库存类", "销售类", "物料类", "财务类"], "description": "指标分类"},
    {"name": "formula", "type": "string", "required": true, "description": "计算公式（伪代码）"},
    {"name": "unit", "type": "string", "required": true, "enum": ["杯", "元", "个", "g", "kg", "L", "%", "次", "天"], "description": "单位"},
    {"name": "data_source", "type": "string", "required": true, "description": "数据来源 Base 表或外部系统"},
    {"name": "refresh_freq", "type": "string", "required": true, "enum": ["实时", "日", "周", "月"], "description": "刷新频率"},
    {"name": "aggregation", "type": "string", "required": true, "enum": ["sum", "avg", "max", "min", "last", "count", "count_distinct"], "description": "聚合方式"},
    {"name": "alert_threshold_ref", "type": "string", "required": false, "description": "关联的阈值 ID（T-{NNN}），无则 null"},
    {"name": "owner", "type": "string", "required": true, "enum": ["加盟商", "督导", "总部", "系统"], "description": "负责方"},
    {"name": "version", "type": "string", "required": true, "format": "v{N}", "description": "版本号"},
    {"name": "status", "type": "string", "required": true, "enum": ["active", "deprecated", "draft"], "description": "状态"}
  ],
  "indicators": [
    {"metric_id": "M-001", "name_zh": "期末库存", "name_en": "ending_inventory", "category": "库存类", "formula": "SUM(ledger.期末库存)", "unit": "g", "data_source": "门店库存台账", "refresh_freq": "日", "aggregation": "sum", "alert_threshold_ref": "T-001", "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-002", "name_zh": "理论期末库存", "name_en": "theoretical_ending_inventory", "category": "库存类", "formula": "期初 + 入库量 - 今日消耗 - 报损量", "unit": "g", "data_source": "门店库存台账（计算列）", "refresh_freq": "日", "aggregation": "sum", "alert_threshold_ref": "T-002", "owner": "系统", "version": "v1", "status": "active"},
    {"metric_id": "M-003", "name_zh": "实盘库存", "name_en": "physical_inventory", "category": "库存类", "formula": "由人工盘点输入（盘点单）", "unit": "g", "data_source": "门店盘点表", "refresh_freq": "周", "aggregation": "last", "alert_threshold_ref": null, "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-004", "name_zh": "理论与实盘差异", "name_en": "theory_vs_actual_diff", "category": "库存类", "formula": "ABS(M-002 - M-003)", "unit": "g", "data_source": "门店库存台账 + 盘点表", "refresh_freq": "周", "aggregation": "max", "alert_threshold_ref": "T-003", "owner": "督导", "version": "v1", "status": "active"},
    {"metric_id": "M-005", "name_zh": "安全库存覆盖率", "name_en": "safety_stock_coverage", "category": "库存类", "formula": "M-001 / 安全库存", "unit": "%", "data_source": "门店库存台账", "refresh_freq": "日", "aggregation": "last", "alert_threshold_ref": "T-004", "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-006", "name_zh": "预警物料数", "name_en": "alert_material_count", "category": "库存类", "formula": "COUNT(物料 WHERE 是否预警='预警')", "unit": "种", "data_source": "门店库存台账", "refresh_freq": "日", "aggregation": "count", "alert_threshold_ref": null, "owner": "督导", "version": "v1", "status": "active"},
    {"metric_id": "M-007", "name_zh": "断货物料数", "name_en": "out_of_stock_count", "category": "库存类", "formula": "COUNT(物料 WHERE M-001 <= 0)", "unit": "种", "data_source": "门店库存台账", "refresh_freq": "日", "aggregation": "count", "alert_threshold_ref": null, "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-008", "name_zh": "库存周转天数", "name_en": "inventory_turnover_days", "category": "库存类", "formula": "M-001 / 平均日消耗", "unit": "天", "data_source": "门店库存台账 + 流水", "refresh_freq": "周", "aggregation": "avg", "alert_threshold_ref": "T-005", "owner": "总部", "version": "v1", "status": "active"},
    {"metric_id": "M-101", "name_zh": "今日销量", "name_en": "today_sales_qty", "category": "销售类", "formula": "SUM(销售明细.销售数量 WHERE 日期=今日)", "unit": "杯", "data_source": "门店销售明细", "refresh_freq": "实时", "aggregation": "sum", "alert_threshold_ref": null, "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-102", "name_zh": "今日销售额", "name_en": "today_sales_amount", "category": "销售类", "formula": "SUM(销售明细.销售金额 WHERE 日期=今日)", "unit": "元", "data_source": "门店销售明细", "refresh_freq": "实时", "aggregation": "sum", "alert_threshold_ref": null, "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-103", "name_zh": "7 日销量均值", "name_en": "avg_7d_sales", "category": "销售类", "formula": "AVG(M-101 OVER 7 DAYS)", "unit": "杯", "data_source": "门店销售明细", "refresh_freq": "日", "aggregation": "avg", "alert_threshold_ref": "T-006", "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-104", "name_zh": "销入比", "name_en": "sale_to_receipt_ratio", "category": "销售类", "formula": "M-101 / SUM(入库单.入库量)", "unit": "%", "data_source": "门店销售明细 + 库存流水", "refresh_freq": "周", "aggregation": "last", "alert_threshold_ref": "T-007", "owner": "总部", "version": "v1", "status": "active"},
    {"metric_id": "M-105", "name_zh": "杯型销量占比", "name_en": "cup_size_share", "category": "销售类", "formula": "GROUP_BY(杯型) SUM(销售数量)", "unit": "%", "data_source": "门店销售明细", "refresh_freq": "日", "aggregation": "sum", "alert_threshold_ref": null, "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-106", "name_zh": "糖量销量占比", "name_en": "sugar_level_share", "category": "销售类", "formula": "GROUP_BY(糖量) SUM(销售数量)", "unit": "%", "data_source": "门店销售明细", "refresh_freq": "日", "aggregation": "sum", "alert_threshold_ref": null, "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-107", "name_zh": "客单价", "name_en": "average_ticket", "category": "销售类", "formula": "M-102 / 单数", "unit": "元", "data_source": "门店销售明细", "refresh_freq": "日", "aggregation": "last", "alert_threshold_ref": null, "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-108", "name_zh": "复购率", "name_en": "repeat_customer_rate", "category": "销售类", "formula": "复购用户数 / 总用户数", "unit": "%", "data_source": "CRM 系统（外部）", "refresh_freq": "周", "aggregation": "last", "alert_threshold_ref": null, "owner": "总部", "version": "v1", "status": "draft"},
    {"metric_id": "M-201", "name_zh": "今日物耗", "name_en": "today_consumption", "category": "物料类", "formula": "SUM(流水.变动数量 WHERE 单据类型='销售物料消耗')", "unit": "g", "data_source": "门店库存流水", "refresh_freq": "日", "aggregation": "sum", "alert_threshold_ref": null, "owner": "系统", "version": "v1", "status": "active"},
    {"metric_id": "M-202", "name_zh": "物料消耗偏差率", "name_en": "material_consumption_variance", "category": "物料类", "formula": "ABS(M-201 - 理论消耗) / 理论消耗", "unit": "%", "data_source": "门店库存流水 + 商品档案配方", "refresh_freq": "日", "aggregation": "max", "alert_threshold_ref": "T-008", "owner": "督导", "version": "v1", "status": "active"},
    {"metric_id": "M-203", "name_zh": "今日报损量", "name_en": "today_waste", "category": "物料类", "formula": "SUM(流水.变动数量 WHERE 单据类型='报损单')", "unit": "g", "data_source": "门店库存流水", "refresh_freq": "日", "aggregation": "sum", "alert_threshold_ref": "T-009", "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-204", "name_zh": "调拨入量", "name_en": "transfer_in_qty", "category": "物料类", "formula": "SUM(流水.变动数量 WHERE 单据类型='调拨入')", "unit": "g", "data_source": "门店库存流水", "refresh_freq": "日", "aggregation": "sum", "alert_threshold_ref": null, "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-205", "name_zh": "调拨出量", "name_en": "transfer_out_qty", "category": "物料类", "formula": "SUM(流水.变动数量 WHERE 单据类型='调拨出')", "unit": "g", "data_source": "门店库存流水", "refresh_freq": "日", "aggregation": "sum", "alert_threshold_ref": null, "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-206", "name_zh": "物料种类数", "name_en": "material_variety_count", "category": "物料类", "formula": "COUNT_DISTINCT(物料主数据.物料名称)", "unit": "种", "data_source": "物料主数据", "refresh_freq": "周", "aggregation": "count_distinct", "alert_threshold_ref": null, "owner": "总部", "version": "v1", "status": "active"},
    {"metric_id": "M-207", "name_zh": "SKU 种类数", "name_en": "sku_count", "category": "物料类", "formula": "COUNT_DISTINCT(商品档案.SKU)", "unit": "种", "data_source": "商品档案", "refresh_freq": "周", "aggregation": "count_distinct", "alert_threshold_ref": null, "owner": "总部", "version": "v1", "status": "active"},
    {"metric_id": "M-208", "name_zh": "配方覆盖率", "name_en": "recipe_coverage", "category": "物料类", "formula": "COUNT(SKU WHERE 配方字段完整) / M-207", "unit": "%", "data_source": "商品档案", "refresh_freq": "周", "aggregation": "last", "alert_threshold_ref": null, "owner": "总部", "version": "v1", "status": "active"},
    {"metric_id": "M-301", "name_zh": "今日销售成本", "name_en": "today_cogs", "category": "财务类", "formula": "SUM(销售明细.SKU → 配方成本)", "unit": "元", "data_source": "门店销售明细 + 商品档案 + 物料主数据", "refresh_freq": "日", "aggregation": "sum", "alert_threshold_ref": null, "owner": "总部", "version": "v1", "status": "active"},
    {"metric_id": "M-302", "name_zh": "毛利率", "name_en": "gross_margin", "category": "财务类", "formula": "(M-102 - M-301) / M-102", "unit": "%", "data_source": "门店销售明细 + 商品档案 + 物料主数据", "refresh_freq": "日", "aggregation": "last", "alert_threshold_ref": "T-010", "owner": "总部", "version": "v1", "status": "active"},
    {"metric_id": "M-303", "name_zh": "原料成本占比", "name_en": "material_cost_ratio", "category": "财务类", "formula": "M-301 / M-102", "unit": "%", "data_source": "门店销售明细 + 商品档案", "refresh_freq": "日", "aggregation": "last", "alert_threshold_ref": "T-011", "owner": "总部", "version": "v1", "status": "active"},
    {"metric_id": "M-304", "name_zh": "单杯成本", "name_en": "cost_per_cup", "category": "财务类", "formula": "M-301 / M-101", "unit": "元", "data_source": "门店销售明细 + 商品档案", "refresh_freq": "日", "aggregation": "last", "alert_threshold_ref": "T-012", "owner": "总部", "version": "v1", "status": "active"},
    {"metric_id": "M-305", "name_zh": "报损金额", "name_en": "waste_amount", "category": "财务类", "formula": "M-203 × 单价", "unit": "元", "data_source": "门店库存流水 + 物料主数据", "refresh_freq": "日", "aggregation": "sum", "alert_threshold_ref": null, "owner": "加盟商", "version": "v1", "status": "active"},
    {"metric_id": "M-306", "name_zh": "盘点差额", "name_en": "stocktake_diff", "category": "财务类", "formula": "(M-002 - M-003) × 单价", "unit": "元", "data_source": "门店库存台账 + 盘点表 + 物料主数据", "refresh_freq": "周", "aggregation": "sum", "alert_threshold_ref": null, "owner": "督导", "version": "v1", "status": "active"}
  ],
  "meta": {
    "total": 30,
    "active": 29,
    "draft": 1,
    "categories": {
      "库存类": 8,
      "销售类": 8,
      "物料类": 8,
      "财务类": 6
    },
    "note": "MVP 第一批 28 个 active 指标全部要求可落地；draft 指标 (M-108 复购率) 待 Phase 2 CRM 接入后激活"
  }
}